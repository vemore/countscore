# Copy this file to .env and fill in the values. NEVER commit .env.

# Anthropic API (required for /comments endpoint)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres
POSTGRES_USER=countscore
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=countscore
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application
COMMENT_MODEL=claude-haiku-4-5
DEFAULT_BUDGET_CENTS=100
# Comma-separated allowed origins. NEVER use "*" (rejected at startup).
# Local dev: http://localhost:3000  |  Prod: the public URL your reverse proxy serves
CORS_ORIGINS=http://localhost:3000

# Per-IP rate limit for the unauthenticated LLM endpoints (cost-abuse guard)
IP_RL_PER_MINUTE=5
IP_RL_PER_HOUR=30

# Per-IP rate limit for POST /groups and POST /groups/join. Its own bucket, so group
# spam cannot eat the LLM quota above. Also caps share_token guessing on /join.
GROUP_RL_PER_MINUTE=3
GROUP_RL_PER_HOUR=10

# Send Strict-Transport-Security. Leave false for local http development; true behind
# the Web Station TLS terminator in production.
HSTS_ENABLED=false

# LLM provider for /comments/zapzap-analysis: bedrock | gemini | mistral (default bedrock)
LLM_PROVIDER=bedrock

# AWS Bedrock (used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# Google Gemini (used when LLM_PROVIDER=gemini) — OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Mistral (used when LLM_PROVIDER=mistral) — OpenAI-compatible endpoint
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# PWA served by this app under a sub-path of its own host, e.g. /countscore (leading
# slash, no trailing slash). Same origin as the API, so it needs no CORS entry.
# Empty = off. scripts/deploy_web.sh reads this value from the NAS .env to build.
PWA_BASE_PATH=
# PWA_DIR=/srv/pwa/current   # inside the container; set by docker-compose.prod.yml

# Logging
LOG_LEVEL=INFO

# --- Production NAS (Synology + Web Station) -------------------------------------
# On the NAS, set these (Web Station handles TLS, so no DOMAIN/Caddy):
#   CORS_ORIGINS=https://countscore.example.com   # your own public URL
#   LLM_PROVIDER=gemini         # the provider you settled on
#   GEMINI_MODEL=gemini-2.5-flash  # never gemini-2.5-pro without billing: its free-tier quota is 0
#   GEMINI_API_KEY=...          # + the key for whichever provider is selected
# The API is published on 127.0.0.1:8087 (see docker-compose.prod.yml); Web Station
# reverse-proxies the public URL to http://localhost:8087.
