# Copy to backend/scripts/deploy.env (gitignored) and fill in your own values.
# deploy_nas.sh sources this file; every variable below is required except
# PUBLIC_URL, which is only echoed back as a reminder at the end of a deploy.

# Docker registry that both this machine and the NAS can reach, host:port.
REGISTRY=registry.example.lan:5050

# SSH alias for the NAS, as defined in your ~/.ssh/config.
NAS_SSH=nas

# Directory on the NAS holding compose.yaml, .env and backups/.
NAS_DEPLOY_DIR=/volume1/docker/countscore

# Public HTTPS URL your reverse proxy serves the API on.
PUBLIC_URL=https://countscore.example.com
