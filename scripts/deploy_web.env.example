# Copy to scripts/deploy_web.env (gitignored) and fill in your own values.
# deploy_web.sh sources this file; every variable below is required except
# WEB_PUBLIC_URL, which is only echoed back at the end of a deploy.

# SSH alias for the NAS, as defined in your ~/.ssh/config.
NAS_SSH=nas

# Folder Web Station serves the PWA from. The script replaces it wholesale and
# keeps the previous release next to it as <folder>.prev.
WEB_NAS_DIR=/volume1/web/countscore

# Sub-path the PWA is served under, with a leading and a trailing slash. It must
# match the path Web Station maps to WEB_NAS_DIR, or every asset 404s.
WEB_BASE_HREF=/countscore/

# Public URL of the PWA, sub-path included.
WEB_PUBLIC_URL=https://countscore.example.com/countscore/
